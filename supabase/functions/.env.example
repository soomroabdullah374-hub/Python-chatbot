# Copy to an ignored supabase/functions/.env for local dev.
# Production: supabase secrets set --env-file supabase/functions/.env
# Provider: groq (default when only a Groq key exists) or xai. Keys may instead live in Supabase Vault
# (groq_api_key / xai_api_key), read via get_runtime_config(); an env value here takes precedence.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
XAI_API_KEY=
XAI_MODEL=
ALLOWED_ORIGINS=http://localhost:3000
PROMPT_VERSION=codebloom-tutor-v1
EMBEDDING_MODEL=gte-small
EMBEDDING_VERSION=gte-small-384-v1
MAX_MESSAGE_CHARACTERS=12000
MAX_REQUEST_BODY_BYTES=32768
MAX_OUTPUT_TOKENS=1800
MAX_TURNS_PER_MINUTE=10
MAX_TURNS_PER_DAY=100
MAX_ACTIVE_TURNS_PER_USER=1
# No-login abuse controls (see IDENTITY.md)
MAX_TURNS_PER_IP_PER_DAY=300
IP_HASH_SALT=
GLOBAL_MAX_TURNS_PER_DAY=
GLOBAL_DAILY_BUDGET_USD=
# Inactivity retention for anonymous learners (decided: 90). The hosted value lives in
# private.app_config.anon_retention_days and is enforced by the codebloom-purge-inactive cron job.
ANON_RETENTION_DAYS=90
MAX_RETRIEVED_CHUNKS=5
CHAT_DEADLINE_MS=90000
UPSTREAM_IDLE_TIMEOUT_MS=30000
GENERATION_LEASE_SECONDS=120
RETRIEVAL_MIN_SIMILARITY=0.8
GENERATION_ENABLED=true
