# Safe to expose in the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile *site* key (invisible widget) used for silent anonymous sign-in.
# Leave empty in local dev if CAPTCHA is disabled in supabase/config.toml.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# There is no login: no auth redirect/callback URLs are needed.
# Do NOT add XAI_API_KEY here. Never create NEXT_PUBLIC_XAI_API_KEY.
# Provider secrets belong in Supabase Edge Function secrets.
# The Turnstile *secret* key goes in Supabase Auth CAPTCHA settings, not here.
